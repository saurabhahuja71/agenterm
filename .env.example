# Used by docker-compose / scripts/run-podman.sh

# Local Ollama (default with network_mode: host)
AGENTERM_BASE_URL=http://127.0.0.1:11434/v1
AGENTERM_MODEL=qwen2.5-coder:32b
AGENTERM_API_KEY=ollama
AGENTERM_PROVIDER=ollama-local

# Remote Ollama example:
# AGENTERM_BASE_URL=http://192.168.1.50:11434/v1
# AGENTERM_MODEL=qwen2.5

# Cloud (optional)
# XAI_API_KEY=
# OPENAI_API_KEY=
